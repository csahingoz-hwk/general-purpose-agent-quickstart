# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Optional AI Gateway credential. Not needed on Vercel when OIDC is enabled for the
# project: deployed functions receive an OIDC token automatically and the AI SDK
# resolves it. Only set this for local development without `vercel env pull`.
AI_GATEWAY_API_KEY=
# Explicit opt-in for the Preview-only AI Gateway lane (Luna/Terra). Default off.
AI_GATEWAY_USAGE_ENABLED=false

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****
# Direct (unpooled) connection for cross-instance chat/retry coordination.
POSTGRES_URL_NON_POOLING=

# https://vercel.com/docs/redis
REDIS_URL=****

# https://docs.composio.dev
COMPOSIO_API_KEY=

# https://console.supermemory.ai
SUPERMEMORY_API_KEY=


# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=****
TELEGRAM_BOT_USERNAME=****
# Any random string — set as secret when registering webhook
TELEGRAM_WEBHOOK_SECRET=****


# Vercel Cron — generate with: openssl rand -base64 32
CRON_SECRET=****

# Server-only: exact existing owner account email; unset denies all app access.
APP_OWNER_EMAIL=

# Google identity login only (no Gmail scopes). Set as server-only preview secrets.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Disabled legacy adapter only. Ordinary OpenAI chat does not require Groq.
GROQ_API_KEY=

# Premium routing remains OFF until the owner separately approves API spending.
# Never prefix these with NEXT_PUBLIC_. No build-time paid generation/probes.
OPENAI_API_KEY=
OPENAI_API_USAGE_ENABLED=false
AI_MONTHLY_ALLOWANCE_USD=10
# Legacy rollback only: both flags required; never an automatic fallback.
CHAT_PROVIDER=openai
ENABLE_LEGACY_GROQ=false
# Before activation, explicitly apply lib/db/usage-schema.sql to the approved DB.
